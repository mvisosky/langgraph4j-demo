{
  "uid": "support-agent",
  "title": "Support Agent - LLM & Graph Observability",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "langgraph4j",
    "langchain4j",
    "genai"
  ],
  "panels": [
    {
      "type": "row",
      "title": "LLM usage (OpenTelemetry GenAI conventions)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "LLM calls / min by model",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_request_model, agent_model_role) (rate({__name__=~\"gen_ai_client_operation_duration.*_count\"}[5m])) * 60",
          "legendFormat": "{{gen_ai_request_model}} ({{agent_model_role}})",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
