          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (increase({__name__=~\"agent_route.*\"}[24h]))",
          "legendFormat": "{{route}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "mode": "seriesToRows"
          }
        }
      ],
